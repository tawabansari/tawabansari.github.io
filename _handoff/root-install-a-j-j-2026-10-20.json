  "persian_edits": [
    {
      "block": 8,
      "before": "- **فرقان، ۲۵:۵۳:** «مِلْحٌ أُجَاجٌ»؛ آب بسیار شور، در برابر آب شیرین و گوارا.\n- **فاطر، ۳۵:۱۲:** «مِلْحٌ أُجَاجٌ»؛ آب بسیار شور، در مقایسه با آب شیرینی که نوشیدن آن آسان است.\n- **واقعه، ۵۶:۷۰:** «أُجَاجًا»؛ آبی بسیار شور که اگر خداوند بخواهد، می‌تواند به جای آب گوارا در اختیار انسان قرار گیرد.",
      "after": "- **فرقان، ۲۵:۵۳:** «مِلْحٌ أُجَاجٌ»؛ آب بسیار شور، در برابر آب شیرین و گوارا.\n- **فاطر، ۳۵:۱۲:** «مِلْحٌ أُجَاجٌ»؛ آب بسیار شور، در مقایسه با آب شیرینی که نوشیدن آن آسان است.\n- **واقعه، ۵۶:۷۰:** «أُجَاجًا»؛ آبی بسیار شور که اگر آن معبود یگانه بخواهد، می‌تواند به جای آب گوارا در اختیار انسان قرار گیرد."
    },
    {
      "block": 11,
      "before": "از خانواده «أ ج ج» صورت‌های دیگری نیز ثبت شده‌اند، اما در قرآن به همین شکل‌ها نیامده‌اند:",
      "after": "از خانواده «أ ج ج» صورت‌های زیر نیز ثبت شده‌اند؛ به‌جز «أُجاج» در وصف آب، دیگر صورت‌ها و کاربردهای این فهرست در قرآن نیامده‌اند:"
    },
    {
      "block": 47,
      "before": "«و گرما با شدتی سوزان و شعله‌وار می‌سوزاند.»",
      "after": "«و گرما با شدتی سوزان و شعله‌وار سوزاند.»"
    },
    {
      "block": 53,
      "before": "رؤبة از شاعران دوره اموی است و این شاهد به دوره اسلامی تعلق دارد؛ نه به دوره جاهلی.",
      "after": "رؤبة از شاعران دوره اموی و آغاز عباسی است و این شاهد به دوره اسلامی تعلق دارد؛ نه به دوره جاهلی."
    },
    {
      "block": 115,
      "before": "«و دو پهنه آب یکسان نیستند: این یکی شیرین و بسیار گواراست و نوشیدن آن آسان و خوشایند است؛ و آن دیگری بسیار شور و گزنده است. و از هر دو، گوشت تازه می‌خورید و زیورهایی بیرون می‌آورید که می‌پوشید؛ و کشتی‌ها را در آن می‌بینی که آب را می‌شکافند، تا از فضل خداوند روزی و بهره بجویید و باشد که سپاس گزارید.»",
      "after": "«و دو پهنه آب یکسان نیستند: این یکی شیرین و بسیار گواراست و نوشیدن آن آسان و خوشایند است؛ و آن دیگری بسیار شور و گزنده است. و از هر دو، گوشت تازه می‌خورید و زیورهایی بیرون می‌آورید که می‌پوشید؛ و کشتی‌ها را در آن می‌بینی که آب را می‌شکافند، تا از فضل آن معبود یگانه روزی و بهره بجویید و باشد که سپاس گزارید.»"
    },
    {
      "block": 154,
      "before": "سپس می‌گوید اگر خداوند بخواهد، می‌تواند آن آب را أجاج قرار دهد.",
      "after": "سپس می‌گوید اگر آن معبود یگانه بخواهد، می‌تواند آن آب را أجاج قرار دهد."
    },
    {
      "block": 160,
      "before": "«لَوْ نَشَاءُ» در این سیاق، قدرت خداوند را در تغییر وضعیت آب یادآوری می‌کند.",
      "after": "«لَوْ نَشَاءُ» در این سیاق، قدرت آن معبود یگانه را در تغییر وضعیت آب یادآوری می‌کند."
    },
    {
      "block": 194,
      "before": "در سنت قرائت، این نام‌ها هم با همزه و هم بدون همزه خوانده شده‌اند.",
      "after": "در قرائت‌های ده‌گانه، عاصم ــ از جمله در روایت حفص ــ این دو نام را با همزه، «يَأْجُوج» و «مَأْجُوج»، می‌خواند؛ دیگر قاریان ده‌گانه همزه را به الف بدل می‌کنند: «يَاجُوج» و «مَاجُوج». این اختلاف در هر دو موضع کهف ۱۸:۹۴ و انبیاء ۲۱:۹۶ برقرار است."
    }
  ],
